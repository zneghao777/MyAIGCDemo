# ==============================================================================
# CineAI Studio · 外部 API 资源清单
# ------------------------------------------------------------------------------
# 本文件记录项目接入的外部 API 资源、接口地址与所需密钥字段。
#
# 【注意】本文件仅用于说明配置项。请勿在此处填写真实密钥；
#         将密钥保存在本地 .env.local 中，公开分发时保持敏感字段为空。
#
# 后端（Python）读取方式：
#     cp .env.example .env.local
#     pydantic-settings 从 .env / .env.local 读取，参见后端 Spec §9
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. LLM · DeepSeek V4.1 Flash
#    用途：剧本 / 分镜 / 提示词的文本生成
#    文档：https://api-docs.deepseek.com/zh-cn/
#    协议：OpenAI 兼容，调用路径 {DEEPSEEK_BASE_URL}/chat/completions
#    模型：deepseek-flash（即 DeepSeek-V4.1-Flash，base_url 与 key 沿用官方）
# ------------------------------------------------------------------------------

# 密钥申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 可选：推理投入强度（low | medium | high），不填使用服务端默认
DEEPSEEK_REASONING_EFFORT=
# 留空沿用模型默认；结构化草稿可设 disabled，复杂推理可设 enabled。
DEEPSEEK_THINKING=


# ------------------------------------------------------------------------------
# 2. 图片生成模型 · gpt-image-2.5（OpenAI 兼容中转）
#    用途：分镜首帧图生成（文生图）与参考图生图（角色一致性）
#    中转地址：https://mfttai.cc
#    协议：入参、出参与 OpenAI 官方 Images API 完全一致
#          文生图 POST {IMAGE_BASE_URL}/v1/images/generations
#          图生图 POST {IMAGE_BASE_URL}/v1/images/edits（multipart，参考图字段 image[]）
#    鉴权：Authorization: Bearer ${IMAGE_API_KEY}
#    模型：gpt-image-2.5
# ------------------------------------------------------------------------------

# 中转服务商密钥（当前正在使用）
IMAGE_API_KEY=

IMAGE_BASE_URL=https://mfttai.cc
IMAGE_MODEL=gpt-image-2.5

# 出图尺寸：竖屏 9:16 → 1024x1536；横屏 16:9 → 1536x1024；方形 1:1 → 1024x1024
IMAGE_SIZE=1024x1536

# 质量档位：low | medium | high（草稿用 low，定稿用 high）
IMAGE_QUALITY=medium

# 单次请求出图数量
IMAGE_N=1

# 返回格式：b64_json | url，留空则使用服务端默认
IMAGE_RESPONSE_FORMAT=b64_json

# 单张出图超时（秒）
IMAGE_TIMEOUT_SECONDS=180


# ------------------------------------------------------------------------------
# 3. 旧 TTS 兼容配置 · MiniMax（默认使用文末 MiMo 配置）
#    用途：分镜旁白 / 配音合成
#    文档：https://platform.minimaxi.com/docs/api-reference/speech-t2a-http
#    接口：POST {MINIMAX_TTS_BASE_URL}/v1/t2a_v2
#    模型：speech-2.8-hd（高保真）/ speech-2.8-turbo（低延迟）
#    说明：仅 TTS_PROVIDER=minimax 或启用 MiniMax 视频时需要此 Key
# ------------------------------------------------------------------------------

# 密钥申请：https://platform.minimaxi.com/user-center/basic-information/interface-key
# TODO 手动填写
MINIMAX_API_KEY=

MINIMAX_TTS_BASE_URL=https://api.minimax.cn
MINIMAX_TTS_MODEL=speech-2.8-hd
MINIMAX_TTS_VOICE_ID=male-qn-qingse
MINIMAX_TTS_AUDIO_FORMAT=mp3

# 可选：部分账号需要额外携带 GroupId，不需要则留空
MINIMAX_GROUP_ID=


# ------------------------------------------------------------------------------
# 4. 视频生成 · CompShare MiniMax H3
# 文档：https://www.compshare.cn/docs/minimax-h3/api/minimax-h3-video-api
# 专用 Key 仅填 .env.local，与 MiniMax TTS 的 Key 独立。
MINIMAX_VIDEO_API_KEY=
MINIMAX_VIDEO_BASE_URL=https://cp.compshare.cn
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_VIDEO_CREATE_PATH=/minimax/v2/video_generation
MINIMAX_VIDEO_QUERY_PATH=/minimax/v2/query/video_generation
# 480P 每秒 5 积分；768P 每秒 10 积分。单镜 4–30 秒。
MINIMAX_VIDEO_RESOLUTION=480P
MINIMAX_VIDEO_POLL_INTERVAL_MS=10000
# 同供应商账号的远端在途并发上限；macOS 每个名额启动独立 solo Worker。
VIDEO_CONCURRENCY_LIMIT=2
# 每项目视频积分硬上限，与 COST_HARD_LIMIT_CENTS 独立。
VIDEO_POINTS_HARD_LIMIT=2000
# 跨进程并发租约，运行时续期；Worker 中断时自动恢复原任务。
VIDEO_LEASE_SECONDS=1200

# ------------------------------------------------------------------------------
# 5. 本地素材（API 和 Worker 共用目录）与七牛临时传输
# 普通预览、下载、合成都读取本地；只有外部 API 要求公网 URL 时上传七牛。
LOCAL_MEDIA_ROOT=data/media
MEDIA_BASE_URL=http://127.0.0.1:8000/media
# 密钥仅填写根目录 .env.local；本地素材服务不要求七牛配置。
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_S3_ENDPOINT=https://s3.cn-east-1.qiniucs.com
QINIU_S3_REGION=cn-east-1
QINIU_S3_BUCKET=aigc2030
QINIU_TEMP_PREFIX=cineai-tmp/
QINIU_TEMP_RETENTION_DAYS=3
QINIU_SIGNED_URL_TTL_SECONDS=86400

# 本机后端
DATABASE_URL=postgresql+asyncpg://zenghao@127.0.0.1:5432/cineai
REDIS_URL=redis://127.0.0.1:6379/4
NEXT_PUBLIC_API_MODE=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
FEATURE_VIDEO_GENERATION=false
COST_HARD_LIMIT_CENTS=5000
COST_UNIT_PRICE_JSON={"llmPerMToken":0,"imagePerCall":0,"ttsPerKChar":0,"videoPerSec":0}
API_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_RATE_LIMIT_PER_MIN=120
MEDIA_MAX_MB=5
TTS_MAX_CHARS=2000
LLM_MAX_TOKENS_PER_JOB=12000
# SUBTITLE_FONT_PATH=/path/to/chinese-font.ttc

# 单次生图实际支持的参考图上限；超出部分记录文本约束降级
IMAGE_MAX_REFERENCES=4

# 当前默认 TTS：小米 MiMo 固定音色；真实密钥仅放 .env.local
TTS_PROVIDER=mimo
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE_ID=白桦

MIMO_TTS_DESIGN_MODEL=mimo-v2.5-tts-voicedesign

MIMO_TTS_CLONE_MODEL=mimo-v2.5-tts-voiceclone
